{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": false,
    "esModuleInterop": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["server.ts", "src/**/*.ts", "lib/**/*.ts", "tests/**/*.ts", "flue.config.ts"],
  "exclude": ["dist", "node_modules"]
}
